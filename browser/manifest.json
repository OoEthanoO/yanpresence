{
  "manifest_version": 3,
  "name": "yanpresence bridge",
  "version": "1.0.0",
  "description": "Reports what the Apple Music web player is playing to yanpresence, over the loopback interface.",
  "permissions": [
    "storage"
  ],
  "host_permissions": [
    "http://127.0.0.1/*",
    "http://localhost/*"
  ],
  "background": {
    "service_worker": "background.js",
    "scripts": [
      "background.js"
    ]
  },
  "content_scripts": [
    {
      "matches": [
        "https://music.apple.com/*"
      ],
      "js": [
        "page.js"
      ],
      "world": "MAIN",
      "all_frames": true,
      "run_at": "document_end"
    },
    {
      "matches": [
        "https://music.apple.com/*"
      ],
      "js": [
        "content.js"
      ],
      "all_frames": true,
      "run_at": "document_end"
    }
  ],
  "options_page": "options.html",
  "browser_specific_settings": {
    "gecko": {
      "id": "yanpresence@localhost",
      "strict_min_version": "128.0"
    }
  }
}
