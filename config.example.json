{
  // Required. Discord Developer Portal -> your application -> Application ID.
  // Name that application "Apple Music": Discord builds the "Listening to ..."
  // header from the application name, not from anything we send.
  "clientId": "",

  // Apple Music storefront for catalog lookups and the links we attach.
  "storefront": "us",

  // Where playback state comes from.
  //   "auto"       -> the Apple apps on macOS and Windows, the web player on
  //                   Linux, where Apple ships no app at all
  //   "apple-apps" -> the Apple Music and Apple TV apps themselves: over Apple
  //                   Events on macOS, over the media session on Windows
  //   "browser"    -> music.apple.com (audio only; Apple TV needs the app)
  "source": "auto",

  // The Apple Music web player. Read two ways, and both can be on at once: the
  // extension bridge wins whenever it has something, because it knows exactly
  // which site is playing.
  //
  // tv.apple.com is not read: Apple TV runs through TV.app on macOS, which
  // reports show/season/episode as fields the web player does not offer.
  //
  //   bridge — the companion extension in browser/ posts here. This is the
  //     only path that works in Chrome: Chrome publishes no page URL over
  //     MPRIS, so nothing else can tell Apple Music from any other tab.
  //     Install it with chrome://extensions -> Developer mode -> Load
  //     unpacked -> the browser/ directory. See browser/README.md.
  //
  //   mpris — no install, reads the session bus. Firefox publishes the page
  //     URL (xesam:url), so it is identified automatically. Chrome publishes
  //     no URL, and for Apple Music no usable metadata either — the site sets
  //     no Media Session metadata in Chrome, so the tab title arrives where
  //     the song should be. Use the extension there.
  //
  //     "players" maps a bus-name fragment onto "music" or "ignore", for a
  //     browser that does publish metadata and that you keep exclusively for
  //     Apple Music — without a URL, every tab in it counts.
  //       "players": { "chromium.instance": "music" }
  "browser": {
    "bridge": {
      "enabled": true,
      "host": "127.0.0.1",
      "port": 8763,
      "staleMs": 6000,
      "token": ""
    },
    "mpris": {
      "enabled": true,
      "busctlPath": "busctl",
      "discoverIntervalMs": 5000,
      "players": {}
    }
  },

  // Which field Discord shows on the one-line status under your name.
  //   "details" -> the song  (this is the default, and what you probably want)
  //   "state"   -> the artist (what Spotify's own integration does)
  //   "name"    -> "Apple Music"
  "statusDisplay": "details",

  // Windows only, and inert everywhere else.
  //
  // tray: a notification-area icon whose menu has Quit. Off here because a run
  //   from a terminal has Ctrl-C and does not need one — the Start menu
  //   shortcut written by `npm run install-windows` passes --tray itself, so
  //   turn this on only if you want the icon for terminal runs too. Windows 11
  //   hides new tray icons behind the ^ arrow; drag it onto the taskbar to
  //   keep it in view.
  //
  // appIds: prefixes of the identifiers the two Store apps publish their media
  //   sessions under. Only worth touching if Apple reissues them under a
  //   different package identity; `yanpresence --smtc` shows what is actually
  //   being published. The "tv" one has never been answered — that app
  //   publishes no session at all — and is kept so a future version that does
  //   is noticed rather than missed.
  //
  // tvUiAutomation: read the Apple TV app through UI Automation, which is the
  //   only way it can be read. It reports whenever the app's playback controls
  //   are on screen and carries the last reading forward in between. Turn it
  //   off to leave the app alone entirely.
  "windows": {
    "tray": false,
    "tvUiAutomation": true,
    "appIds": {
      "music": "AppleInc.AppleMusicWin",
      "tv": "AppleInc.AppleTVWin"
    }
  },

  // Apple TV, through TV.app on macOS and the Apple TV app on Windows. Only
  // one source holds the presence at a time: whatever is actually playing
  // wins, and video beats audio when both are. Ignored when "source" resolves
  // to "browser".
  //
  // On Windows the show, the season and the episode are read out of the free
  // text the app publishes to the media session rather than from properties,
  // because there are no properties to ask for. Run `yanpresence --smtc` while
  // something is playing to see both what arrived and what was made of it.
  //
  // clientId: Discord builds the card header from the *application* name, and
  //   one connection speaks for one application. Left empty, TV is announced
  //   through the Apple Music application and the header reads "Watching
  //   Apple Music". Create a SECOND Discord application named "Apple TV" and
  //   paste its Application ID here for the correct header — yanpresence
  //   reconnects automatically as it switches between the two.
  //
  // Artwork comes from the backend behind tv.apple.com (the iTunes Search API
  // no longer carries TV content, and TV+ streams have no embedded cover).
  // That covers the Apple TV+ catalogue; a purchased Store film finds no match
  // and falls back to placeholderImageKey.
  "tv": {
    "enabled": false,
    "clientId": "",
    "activityName": "Apple TV",
    "showSmallImage": false,
    "smallImageKey": "appletv"
  },

  // Where encoded artwork is hosted so Discord has a URL to fetch.
  //
  // "webhook": post to a Discord webhook you own (Channel -> Edit Channel ->
  //   Integrations -> Webhooks -> New Webhook). Easiest. Subject to Discord's
  //   per-file cap: 10MB unboosted, 50MB at Boost Level 2.
  //
  // "command": hand the file to your own uploader and read the URL it prints.
  //   No Discord involvement and no cap. {file} and {name} are substituted:
  //     "rclone copyto {file} r2:art/{name} >&2 && echo https://cdn.you.com/{name}"
  //     "aws s3 cp {file} s3://bucket/{name} >&2 && echo https://cdn.you.com/{name}"
  // "s3" is the recommended mode. NOTE: "webhook" uploads fine but Discord
  // will NOT render cdn.discordapp.com URLs as presence assets — they carry a
  // signed query string and come out as the grey "?" placeholder.
  //
  // For Cloudflare R2, fill in all five s3 fields. See the README.
  "hosting": {
    "mode": "s3",
    "s3": {
      "endpoint": "https://<accountId>.r2.cloudflarestorage.com",
      "bucket": "yanpresence",
      "accessKeyId": "",
      "secretAccessKey": "",
      "region": "auto",
      "publicBaseUrl": "https://pub-<hash>.r2.dev"
    },
    "command": "",
    "webhookUrl": ""
  },

  // Animated album art. These defaults sacrifice nothing: the FULL loop, at
  // source framerate, at high quality — ~3.7MB, which fits a free webhook.
  //
  // Measured on a real Apple motion master (full 20.6s loop, 30fps):
  //   1024px AVIF crf20 ->  3.7MB      2160px AVIF crf26 ->  8.4MB
  //   2160px AVIF crf20 -> 12.2MB      2160px AVIF crf14 -> 18.8MB
  //   2160px WebP q92   -> 88.3MB      1000px GIF        -> ~128MB
  //
  // format: "avif" (default) | "webp" (needs `brew install webp`) | "gif"
  // maxDurationSec: null plays the whole loop. Set a number only to truncate.
  // onOversize: "degrade" refits over-budget encodes; "skip" refuses to
  //   compromise and falls back to static art instead.
  //
  // For absolute maximum — Apple's full 2160x2160 at near-source quality —
  // use size 2160 + crf 14 with "command" hosting and "maxBytes": null.
  "animatedArtwork": {
    "enabled": true,
    "format": "avif",
    "size": 1024,
    "fps": 30,
    "maxDurationSec": null,
    "crf": 20,
    "quality": 75,
    "onOversize": "degrade",
    "ffmpegPath": "ffmpeg",
    "img2webpPath": "img2webp",

    // GPU encoding. Nothing to configure: devices are discovered, ffmpeg is
    // asked what it can do, and anything that fails falls back to the CPU
    // encoder with a warning.
    //
    // mode: "auto" | "off" | "amf" | "vaapi".
    //   "auto" hands the AV1 encode to AMD's AMF encoder on Windows when
    //   there is an AMD adapter and an ffmpeg built with av1_amf. Measured on
    //   a Radeon 780M: 19.6MB in 5.7s against libsvtav1 crf20's 21.4MB in
    //   6.5s, and Chromium — which is what Discord is — decodes the result.
    //
    //   On Linux "auto" means the CPU, and that is not an oversight. The same
    //   GPU through VAAPI produces AVIF that ffmpeg reads back happily and
    //   Chromium refuses to decode, so the card renders a grey "?". Set
    //   "vaapi" to force it anyway; it warns when you do.
    //
    // device: "auto" | "amd" | "intel" | "nvidia" | "/dev/dri/renderD129".
    //   VAAPI only, and it picks by vendor rather than by number: renderD128
    //   is the discrete NVIDIA card on plenty of laptops and has no VAAPI
    //   encoder at all. AMF enumerates only AMD devices, so it cannot pick
    //   wrong and ignores this.
    //
    // decode: hardware decode of the source video, independent of the encode.
    //   Off because it measured slower nearly everywhere — including 7.5s
    //   against 5.7s when paired with AMF, where the frames have to come back
    //   to system memory for the scale filter and then go up again.
    "hardware": {
      "mode": "auto",
      "device": "auto",
      "decode": false,
      "globalQuality": null
    }
  },

  // How long a pause waits before the presence comes down, as opposed to a
  // stop. null asks the source: clearDelayMs (5s) for Music.app, whose pause is
  // ambiguous between tracks, and 1.5s for the web player, whose pause is not.
  "pauseClearDelayMs": null,

  "showWhenPaused": false,
  "showSmallImage": true,
  "smallImageKey": "applemusic",
  "placeholderImageKey": "blank",
  "linkButtons": false,
  "artworkSize": 1024,
  "pollIntervalMs": 1000,
  "logLevel": "info"
}
