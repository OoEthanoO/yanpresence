{
  "name": "yanpresence",
  "version": "1.0.0",
  "description": "Apple Music -> Discord Rich Presence for macOS, Windows and Linux",
  "type": "module",
  "bin": {
    "yanpresence": "./bin/yanpresence.js"
  },
  "main": "./src/index.js",
  "scripts": {
    "start": "node bin/yanpresence.js",
    "test": "node --test test/*.test.js",
    "doctor": "node bin/yanpresence.js --doctor",
    "install-agent": "bash launchd/install.sh",
    "uninstall-agent": "bash launchd/uninstall.sh",
    "install-service": "bash systemd/install.sh",
    "uninstall-service": "bash systemd/uninstall.sh",
    "install-windows": "powershell -NoProfile -ExecutionPolicy Bypass -File windows/install.ps1",
    "uninstall-windows": "powershell -NoProfile -ExecutionPolicy Bypass -File windows/uninstall.ps1",
    "make-icon": "powershell -NoProfile -ExecutionPolicy Bypass -File scripts/make-icon.ps1",
    "build:windows": "powershell -NoProfile -ExecutionPolicy Bypass -File scripts/build-windows.ps1 -BootstrapCompiler",
    "test:windows-package": "powershell -NoProfile -ExecutionPolicy Bypass -File scripts/test-windows-package.ps1"
  },
  "engines": {
    "node": ">=18"
  },
  "os": [
    "darwin",
    "linux",
    "win32"
  ],
  "license": "MIT",
  "private": true
}
